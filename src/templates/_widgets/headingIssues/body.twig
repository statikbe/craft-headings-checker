{# Heading issues widget (src/widgets/HeadingIssues.php): building, or items = [{title, url, site, issues}], total and
   rebuilding (the list shown is for older settings while a new one is built) #}
{% if building %}
    <p class="light">{{ 'Building the list of pages with heading issues. Come back in a few minutes.'|t('headings-checker') }}</p>
{% elseif items is empty %}
    {% if rebuilding ?? false %}
        <p class="light">{{ 'The list is being updated for changed settings.'|t('headings-checker') }}</p>
    {% endif %}
    <p class="light">{{ 'No pages with heading issues.'|t('headings-checker') }}</p>
{% else %}
    {% if rebuilding ?? false %}
        <p class="light">{{ 'The list is being updated for changed settings.'|t('headings-checker') }}</p>
    {% endif %}
    <p class="light">{{ '{count, plural, =1{# page has} other{# pages have}} heading issues.'|t('headings-checker', { count: total }) }}</p>
    <ul style="list-style: none; padding: 0; margin: 0;">
        {% for item in items %}
            <li style="padding: 8px 0;{% if not loop.first %} border-top: 1px solid var(--hairline-color);{% endif %}">
                <a href="{{ item.url }}"><strong>{{ item.title }}</strong></a>
                {% if multiSite %}<span class="light"> · {{ item.site }}</span>{% endif %}
                <details style="margin-top: 4px;">
                    <summary class="light" style="cursor: pointer;">{{ '{count, plural, =1{# issue} other{# issues}}'|t('headings-checker', { count: item.issues|length }) }}</summary>
                    <ul style="list-style: disc; padding-inline-start: 20px; margin-top: 4px;">
                        {% for issue in item.issues %}
                            <li>{{ issue }}</li>
                        {% endfor %}
                    </ul>
                </details>
            </li>
        {% endfor %}
    </ul>
    {% if total > items|length %}
        <p class="light">{{ 'And {count} more. Run {command} for the full list.'|t('headings-checker', { count: total - items|length, command: '<code>craft headings-checker/check</code>' })|raw }}</p>
    {% endif %}
{% endif %}
